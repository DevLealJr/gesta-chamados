<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"] - AlunosTech Hub</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">AlunosTech Hub</a>
            @if (Context.Session.GetString("userName") is not null)
            {
                <form asp-controller="Account" asp-action="Logout" method="post" class="ms-auto">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-light" type="submit">Sair</button>
                </form>
            }
        </div>
    </nav>
    <main>
        @RenderBody()
    </main>
</body>
</html>
