FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8080
EXPOSE 8081
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore ./AlunosTechHub.slnx
RUN dotnet publish ./src/AlunosTech.Api/AlunosTech.Api.csproj -c Release -o /app/publish
FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .
ENV Kestrel__Endpoints__Http__Url=http://+:8080
ENTRYPOINT ["dotnet", "AlunosTech.Api.dll"]
